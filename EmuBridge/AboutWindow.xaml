<Window x:Class="EmuBridge.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EmuBridge"
        Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand mark: gradient disc + wordmark, the same identity as MainWindow's brand bar. -->
        <StackPanel HorizontalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,10"
                    Background="{StaticResource EmuBridgeAccentGradientBrush}">
                <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="22"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="EmuBridge" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="VersionText" Text="Version"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,4,0,20" />

        <TextBlock Grid.Row="2" Text="Made with care by ZavalaSebas"
                   HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,20" />

        <Border Grid.Row="3" CornerRadius="12" Padding="14" VerticalAlignment="Top"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                EmuBridge is a retro emulation launcher. It manages ROMs and emulators you already own
                — it does not include, facilitate, or link to ROM downloads.
                <LineBreak />
                <LineBreak />
                This software is provided &quot;as is&quot;, without warranty of any kind, express or
                implied. Use at your own risk. See the
                <Hyperlink NavigateUri="https://github.com/ZavalaSebas/EmuBridge/blob/main/LICENSE"
                          RequestNavigate="LicenseLink_RequestNavigate">LICENSE</Hyperlink>
                file for details.
            </TextBlock>
        </Border>

        <Button Grid.Row="4" Content="Close" IsCancel="True" IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="100" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="12,6" />
    </Grid>
</Window>
