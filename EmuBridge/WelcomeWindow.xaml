<Window x:Class="EmuBridge.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to EmuBridge"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand mark: gradient disc + wordmark, the same identity as MainWindow's brand bar. -->
        <StackPanel HorizontalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,10"
                    Background="{StaticResource EmuBridgeAccentGradientBrush}">
                <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="24"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Welcome to EmuBridge" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="VersionText" Text="Version"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,4,0,20" />

        <TextBlock Grid.Row="2" Text="What's new in this version" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12" Foreground="{StaticResource EmuBridgeAccent2Brush}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="12" Padding="14,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="&#8226; Theme customization — follow Windows, or pick Light or Dark, from Settings." Margin="0,0,8,0" />
                    <TextBlock TextWrapping="Wrap" Text="&#8226; Auto-updater — EmuBridge checks for a new version on startup and can update itself in place, no manual download." Margin="0,0,8,0" />
                    <TextBlock TextWrapping="Wrap" Text="&#8226; This welcome dialog — shows once per version, so you see what changed." Margin="0,0,8,0" />
                    <TextBlock TextWrapping="Wrap" Text="&#8226; A full visual overhaul — brand gradient identity, card-based layout, and a new Big Picture landing." Margin="0,0,8,0" />
                    <TextBlock TextWrapping="Wrap" Text="&#8226; Support and credits — an About dialog and sponsor link, always a click away." Margin="0,0,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="4" Content="Let's Go" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"
                Width="120" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="12,6" />
    </Grid>
</Window>
