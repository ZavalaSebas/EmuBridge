<Window x:Class="EmuBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EmuBridge.Models"
        xmlns:conv="clr-namespace:EmuBridge.Converters"
        Title="Settings" Height="720" Width="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <!-- The whole page scrolls as one unit (a single, predictable scrollbar when the window is
         short), while the Emulators section keeps a fixed, generous height so its platform list
         never collapses to one item at a time. Each section is a card: rounded border, subtle
         fill, and a header with the short brand accent bar (SectionHeaderStyle in App.xaml). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="330" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Emulators section -->
            <Border Grid.Row="0" CornerRadius="12" Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Emulators" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding Platforms}"
                                 SelectedItem="{Binding SelectedPlatform}"
                                 DisplayMemberPath="PlatformName"
                                 Margin="0,0,10,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Executable" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding BrowseExecutableCommand}" Margin="8,0,0,0" Padding="12,6" />
                            </Grid>

                            <TextBlock Text="Argument Template" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            <TextBlock Text="Must include {RomPath}. Example: &quot;{RomPath}&quot; -fullscreen"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Save Emulator Config" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveEmulatorProfileCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                        Padding="16,7" Margin="0,0,8,0" />
                                <Button Content="Auto-Install" Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding AutoInstallCommand}"
                                        Visibility="{Binding SelectedPlatform.HasKnownInstallOption, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                        Padding="14,7" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- SteamGridDB API key section -->
            <Border Grid.Row="1" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="SteamGridDB API Key" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Save Key" Style="{StaticResource PillButtonStyle}"
                                Command="{Binding SaveApiKeyCommand}" Margin="8,0,0,0" Padding="12,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TheGamesDB API key section (metadata-source decision, 2026-08-04) -->
            <Border Grid.Row="2" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="TheGamesDB API Key" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TheGamesDbApiKey, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Save Key" Style="{StaticResource PillButtonStyle}"
                                Command="{Binding SaveTheGamesDbApiKeyCommand}" Margin="8,0,0,0" Padding="12,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cheats section -->
            <Border Grid.Row="3" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Cheats" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Margin="2,0,0,0" Content="Auto-apply cheats on launch"
                              IsChecked="{Binding AutoApplyCheatsOnLaunch}"
                              Command="{Binding SaveAutoApplyCheatsOnLaunchCommand}" />
                </StackPanel>
            </Border>

            <!-- Appearance section (Phase Polish -> "Theme customization") — applied live on change,
                 persisted via SettingsService; System (follow Windows) is the default. -->
            <Border Grid.Row="4" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="2,0,10,0" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding ThemePreference}"
                                  SelectedValuePath="Tag" HorizontalAlignment="Left" MinWidth="170">
                            <ComboBoxItem Content="Follow Windows" Tag="{x:Static models:ThemePreference.System}" />
                            <ComboBoxItem Content="Light" Tag="{x:Static models:ThemePreference.Light}" />
                            <ComboBoxItem Content="Dark" Tag="{x:Static models:ThemePreference.Dark}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates section (Phase Polish -> "Auto-updater") — the startup check respects the
                 toggle below; the button runs a check on demand, offering to install any update. -->
            <Border Grid.Row="5" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Margin="2,0,0,0" Content="Check for updates on startup"
                              IsChecked="{Binding CheckForUpdatesOnStartup}" />
                    <Button Content="Check for Updates Now" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckForUpdatesCommand}"
                            HorizontalAlignment="Left" Margin="2,12,0,0" Padding="16,7" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="6" Margin="4,14,4,4">
                <!-- Busy: auto-install progress -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource PillButtonStyle}"
                            Command="{Binding CancelInstallCommand}" Padding="12,5" Margin="12,0,0,0" />
                </Grid>

                <!-- Not busy: plain status text (Saved., API key saved., etc.) -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="#2ECC71"
                           Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
