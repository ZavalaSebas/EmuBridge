<ui:FluentWindow x:Class="EmuBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmuBridge.ViewModels"
        xmlns:conv="clr-namespace:EmuBridge.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EmuBridge" Height="650" Width="950"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowState="{Binding IsBigPictureMode, Converter={StaticResource BoolToWindowStateConverter}, Mode=OneWay}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <!-- Bypasses WPF's own process-level bitmap cache — see ARCHITECTURE.md -> ADR-23 (Update)
             and DEVELOPMENT.md -> Image Loading. -->
        <conv:CachedImagePathConverter x:Key="CachedImagePathConverter" />

        <!-- Glyphs are Segoe MDL2 Assets (free, ships with Windows 10/11 — no image assets). -->
        <!-- PillButtonStyle/PrimaryButtonStyle/GlyphTextStyle live in App.xaml (shared with the
             Settings/Welcome/About windows). -->

        <!-- One shared menu for every tile now (View Details applies to any game; Remove from
             Library stays IsMissing-only, ADR-15) — only one instance is ever open at a time, so
             WPF re-parents PlacementTarget per-invocation. Bindings route through PlacementTarget
             rather than relying on ContextMenu's (unreliable) DataContext inheritance from its
             owning Button. Tag now carries the whole MainViewModel (not one single command, the
             original shape) so any menu item here can reach whichever command it needs. -->
        <ContextMenu x:Key="GameTileContextMenu">
            <MenuItem Header="View Details"
                      Command="{Binding PlacementTarget.Tag.ViewGameDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="Add to Favorites" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Header" Value="Remove from Favorites" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Configure Emulator..."
                      Command="{Binding PlacementTarget.Tag.ConfigureEmulatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Cheats..."
                      Command="{Binding PlacementTarget.Tag.OpenCheatsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove from Library"
                      Visibility="{Binding PlacementTarget.DataContext.IsMissing, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"
                      Command="{Binding PlacementTarget.Tag.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- The game tile card. Both tile templates (normal grid + Big Picture) are cards with this
             shared look: rounded corners, a 1px divider border that flips to the brand gradient on
             hover, a soft radial glow that fades in behind the hovered card (a brush, not a
             DropShadowEffect — see App.xaml's TileHoverGlowBrush comment), and a gentle scale-up.
             Foreground is set explicitly because this keyed style replaces WPF-UI's implicit Button
             style (a keyed style can't BasedOn an implicit one) — without it, tile text falls back
             to stock WPF's black button foreground (the black-on-dark bug class ADR-29 fixed
             per-window, fixed here per-style). -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="12" Margin="-2"
                                    Background="{StaticResource TileHoverGlowBrush}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Card" CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource EmuBridgeAccentGradientBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource EmuBridgeAccentGradientBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- IsMissing lives on the GameTile DataContext, not the Button, so it needs a
                     DataTrigger. Dims the whole card, same intent as the old opacity dimming. -->
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Normal grid tile: a portrait card — cover on top (clipped to the card's rounded corners
             by the card Border's Background), title + year below, favorite star chip and missing
             pill overlaid on the cover. -->
        <DataTemplate x:Key="GameTileTemplate" DataType="{x:Type vm:GameTile}">
            <Button Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Style="{StaticResource CardButtonStyle}"
                    ToolTip="{Binding Name}">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Button.RenderTransform>
                <Grid Width="200" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="268" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cover -->
                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource CoverPlaceholderBrush}">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="34"
                                       Foreground="{DynamicResource SubtleFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding CoverImagePath, Converter={StaticResource CachedImagePathConverter}}" Stretch="UniformToFill" />

                        <!-- Favorite star chip -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                Background="#B3000000" CornerRadius="10" Padding="6,3"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE734;" Style="{StaticResource GlyphTextStyle}" FontSize="11" Foreground="#FFD34D" />
                        </Border>

                        <!-- Missing pill -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                                Background="#CC572B20" CornerRadius="9" Padding="8,3"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="missing" FontSize="10" FontWeight="SemiBold" Foreground="#FFB06A" />
                        </Border>
                    </Grid>

                    <!-- Title + year -->
                    <StackPanel Grid.Row="1" Margin="10,10,10,12">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" LineHeight="18" />
                        <TextBlock Text="{Binding ReleaseYearText}" TextAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReleaseYearText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Same bindings/ContextMenu as GameTileTemplate, just a cinematic landscape presentation —
             Big Picture mode is a different presentation of the same tiles, not different data
             (ARCHITECTURE.md -> ADR-22). The cover fills the whole card and the title sits on a
             dark scrim at the bottom, so it reads over any cover art. -->
        <DataTemplate x:Key="BigPictureTileTemplate" DataType="{x:Type vm:GameTile}">
            <Button Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Style="{StaticResource CardButtonStyle}"
                    ToolTip="{Binding Name}">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Button.RenderTransform>
                <Grid Width="430" Height="200" Margin="6">
                    <Border Background="{StaticResource CoverPlaceholderBrush}">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="40"
                                   Foreground="{DynamicResource SubtleFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding BigPictureCoverImagePath, Converter={StaticResource CachedImagePathConverter}}" Stretch="UniformToFill" />

                    <!-- Title scrim -->
                    <Border VerticalAlignment="Bottom" Background="{StaticResource BigPictureScrimBrush}" Padding="14,20">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding ReleaseYearText}" FontSize="12" Foreground="#CFFFFFFF" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CFFFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReleaseYearText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Favorite star chip -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                            Background="#B3000000" CornerRadius="12" Padding="8,4"
                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="&#xE734;" Style="{StaticResource GlyphTextStyle}" FontSize="13" Foreground="#FFD34D" />
                    </Border>

                    <!-- Missing pill -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                            Background="#CC572B20" CornerRadius="10" Padding="10,4"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="missing" FontSize="11" FontWeight="SemiBold" Foreground="#FFB06A" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EmuBridge" />

        <!-- Brand bar: wordmark on the left, primary/secondary actions on the right. -->
        <Grid Grid.Row="1" Margin="18,10,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9"
                        Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,11,0">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="15"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="EmuBridge" FontSize="23" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7C5CFF" Offset="0" />
                            <GradientStop Color="#FF5FA2" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFolderCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource GlyphTextStyle}" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="Add Folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}" Command="{Binding RefreshLibraryCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphTextStyle}" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings" Width="38">
                    <TextBlock Text="&#xE713;" Style="{StaticResource GlyphTextStyle}" FontSize="14" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hero banner: a compact brand-gradient strip over the library — shows how many games are
             ready. Collapses to nothing when no scan folders exist yet (the empty state takes over). -->
        <Border Grid.Row="2" Margin="18,14,18,0" Padding="20,15" CornerRadius="14"
                Background="{StaticResource EmuBridgeAccentGradientBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoScanFolders}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Your library, ready to play." FontSize="17" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Games.Count, StringFormat={}{0} games ready}" FontSize="12"
                               Foreground="#DDFFFFFF" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="46"
                           Foreground="#26FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
            </Grid>
        </Border>

        <!-- Filter bar: sort/filter controls in a subtle card, with the game count on the right. -->
        <Border Grid.Row="3" Margin="18,12,18,14" Padding="14,9" CornerRadius="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox SelectedValue="{Binding SortMode}" SelectedValuePath="Tag" Width="150" Margin="0,0,20,0">
                        <ComboBoxItem Content="Name" Tag="{x:Static vm:LibrarySortMode.Name}" />
                        <ComboBoxItem Content="Recently Played" Tag="{x:Static vm:LibrarySortMode.RecentlyPlayed}" />
                        <ComboBoxItem Content="Favorites First" Tag="{x:Static vm:LibrarySortMode.FavoritesFirst}" />
                    </ComboBox>
                    <CheckBox Content="Favorites only" IsChecked="{Binding ShowFavoritesOnly}" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <CheckBox Content="Big Picture" IsChecked="{Binding IsBigPictureMode}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Games.Count, StringFormat={}{0} games}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="4">
            <!-- Phase Polish -> "Polished transition animations": fade the whole content area in
                 whenever the mode changes (Library <-> Big Picture). Both triggers fire on their
                 respective toggle, so switching views reads as a soft crossfade instead of a hard
                 cut — the same underlying data, just re-presented (ADR-22). -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBigPictureMode}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Empty state: no scan folders configured yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasNoScanFolders, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="92" Height="92" CornerRadius="46"
                        Background="{StaticResource EmuBridgeAccentGradientBrush}" Margin="0,0,0,20">
                    <Border.Effect>
                        <!-- Static, single-element halo around the empty-state icon — cheap enough to
                             be the one allowed shadow in the app; tiles themselves use the radial glow
                             brush instead (see CardButtonStyle). -->
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#7C5CFF" />
                    </Border.Effect>
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphTextStyle}" FontSize="38"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No ROM folders yet" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Add a folder and EmuBridge will detect your games, fetch cover art, and hook up the right emulator — no setup by hand."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center" Padding="26,11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource GlyphTextStyle}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add Folder" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Cover grid (normal mode) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoScanFolders}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Big Picture mode: same Games/TrySomethingNewGames data, streaming-style presentation
                 (larger tiles, maximized window via BoolToWindowStateConverter on the Window itself)
                 — no animation, same scope discipline as the Library view refinement (ADR-21). -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNoScanFolders}" Value="False" />
                                    <Condition Binding="{Binding IsBigPictureMode}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Never-played, still-present games, alphabetical — no scoring, no randomness
                     (ARCHITECTURE.md -> ADR-22). Hidden entirely when there are no candidates. -->
                <StackPanel Grid.Row="0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrySomethingNewGames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Try Something New" FontSize="21" FontWeight="Bold" Margin="18,14,16,6"
                               Foreground="{StaticResource EmuBridgeAccent2Brush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TrySomethingNewGames}" ItemTemplate="{StaticResource BigPictureTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Full library, same Games collection (already sorted/filtered by SortMode/
                     ShowFavoritesOnly) as the normal grid, just bigger tiles. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource BigPictureTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar: scan/box-art progress -->
        <Grid Grid.Row="5" Margin="18,0,18,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource PillButtonStyle}"
                    Command="{Binding CancelCommand}" Margin="12,0,0,0" />
        </Grid>

        <!-- Footer: version, About/credits, and the sponsor link — always reachable, never in the
             way. The Ko-fi button uses the brand gradient so the one sponsorship surface in the app
             is also its most eye-catching. -->
        <Grid Grid.Row="6" Margin="18,10,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding AppVersionText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="About" Style="{StaticResource PillButtonStyle}"
                        Command="{Binding OpenAboutCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenSponsorCommand}"
                        ToolTip="Support the project" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA5A;" Style="{StaticResource GlyphTextStyle}" FontSize="12" Margin="0,0,6,0" />
