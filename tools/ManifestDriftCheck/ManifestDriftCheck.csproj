<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ManifestDriftCheck</RootNamespace>

    <!-- CI-only implementation detail of the manifest-drift-check GitHub Action (ARCHITECTURE.md
         -> ADR-25) — never invoked manually by a maintainer, never shipped in EmuBridge.exe. Lives
         under tools/ specifically so it never enters EmuBridge.csproj's publish output. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EmuBridge\EmuBridge.csproj" />
  </ItemGroup>

</Project>
