<Window x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bridge.ViewModels"
        xmlns:conv="clr-namespace:Bridge.Converters"
        Title="Bridge" Height="650" Width="950"
        WindowState="{Binding IsBigPictureMode, Converter={StaticResource BoolToWindowStateConverter}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <!-- Bypasses WPF's own process-level bitmap cache — see ARCHITECTURE.md -> ADR-23 (Update)
             and DEVELOPMENT.md -> Image Loading. -->
        <conv:CachedImagePathConverter x:Key="CachedImagePathConverter" />

        <!-- One shared menu for every tile now (View Details applies to any game; Remove from
             Library stays IsMissing-only, ADR-15) — only one instance is ever open at a time, so
             WPF re-parents PlacementTarget per-invocation. Bindings route through PlacementTarget
             rather than relying on ContextMenu's (unreliable) DataContext inheritance from its
             owning Button. Tag now carries the whole MainViewModel (not one single command, the
             original shape) so any menu item here can reach whichever command it needs. -->
        <ContextMenu x:Key="GameTileContextMenu">
            <MenuItem Header="View Details"
                      Command="{Binding PlacementTarget.Tag.ViewGameDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="Add to Favorites" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                <Setter Property="Header" Value="Remove from Favorites" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Configure Emulator..."
                      Command="{Binding PlacementTarget.Tag.ConfigureEmulatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Cheats..."
                      Command="{Binding PlacementTarget.Tag.OpenCheatsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove from Library"
                      Visibility="{Binding PlacementTarget.DataContext.IsMissing, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"
                      Command="{Binding PlacementTarget.Tag.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <DataTemplate x:Key="GameTileTemplate" DataType="{x:Type vm:GameTile}">
            <Button Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Margin="6" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Name}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Width="200">
                    <Grid Height="300">
                        <Border Background="#333333" CornerRadius="4">
                            <TextBlock Text="No Cover" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding CoverImagePath, Converter={StaticResource CachedImagePathConverter}}" Stretch="UniformToFill" />
                        <TextBlock Text="&#9733;" FontSize="20" Foreground="Gold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ReleaseYearText}" Foreground="Gray" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReleaseYearText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="(missing)" Foreground="OrangeRed" HorizontalAlignment="Center" FontSize="11"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Same bindings/ContextMenu as GameTileTemplate, just larger — Big Picture mode is a
             different presentation of the same tiles, not different data (ARCHITECTURE.md -> ADR-22). -->
        <DataTemplate x:Key="BigPictureTileTemplate" DataType="{x:Type vm:GameTile}">
            <Button Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource GameTileContextMenu}"
                    Margin="10" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Name}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Width="460">
                    <Grid Height="215">
                        <Border Background="#333333" CornerRadius="6">
                            <TextBlock Text="No Cover" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding BigPictureCoverImagePath, Converter={StaticResource CachedImagePathConverter}}" Stretch="UniformToFill" />
                        <TextBlock Text="&#9733;" FontSize="28" Foreground="Gold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ReleaseYearText}" Foreground="Gray" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReleaseYearText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="(missing)" Foreground="OrangeRed" HorizontalAlignment="Center" FontSize="13"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="Add Folder" Command="{Binding AddFolderCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Rescan" Command="{Binding RefreshLibraryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Padding="10,4" Margin="0,0,16,0" />

            <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox SelectedValue="{Binding SortMode}" SelectedValuePath="Tag" Width="140" Margin="0,0,12,0">
                <ComboBoxItem Content="Name" Tag="{x:Static vm:LibrarySortMode.Name}" />
                <ComboBoxItem Content="Recently Played" Tag="{x:Static vm:LibrarySortMode.RecentlyPlayed}" />
                <ComboBoxItem Content="Favorites First" Tag="{x:Static vm:LibrarySortMode.FavoritesFirst}" />
            </ComboBox>

            <CheckBox Content="Favorites only" IsChecked="{Binding ShowFavoritesOnly}" VerticalAlignment="Center" Margin="0,0,16,0" />

            <CheckBox Content="Big Picture" IsChecked="{Binding IsBigPictureMode}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Empty state: no scan folders configured yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoScanFolders, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No ROM folders configured yet" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <Button Content="Add Folder" Command="{Binding AddFolderCommand}" Padding="20,10" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Cover grid (normal mode) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoScanFolders}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Big Picture mode: same Games/TrySomethingNewGames data, streaming-style presentation
                 (larger tiles, maximized window via BoolToWindowStateConverter on the Window itself)
                 — no animation, same scope discipline as the Library view refinement (ADR-21). -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasNoScanFolders}" Value="False" />
                                    <Condition Binding="{Binding IsBigPictureMode}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Never-played, still-present games, alphabetical — no scoring, no randomness
                     (ARCHITECTURE.md -> ADR-22). Hidden entirely when there are no candidates. -->
                <StackPanel Grid.Row="0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrySomethingNewGames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Try Something New" FontSize="22" FontWeight="Bold" Margin="16,16,16,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TrySomethingNewGames}" ItemTemplate="{StaticResource BigPictureTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Full library, same Games collection (already sorted/filtered by SortMode/
                     ShowFavoritesOnly) as the normal grid, just bigger tiles. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource BigPictureTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar: scan/box-art progress -->
        <Grid Grid.Row="2" Margin="8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Padding="10,4" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
