<Window x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bridge.ViewModels"
        xmlns:conv="clr-namespace:Bridge.Converters"
        Title="Bridge" Height="650" Width="950">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <DataTemplate x:Key="GameTileTemplate" DataType="{x:Type vm:GameTile}">
            <Button Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Margin="6" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Name}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Width="200">
                    <Grid Height="300">
                        <Border Background="#333333" CornerRadius="4">
                            <TextBlock Text="No Cover" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="(missing)" Foreground="OrangeRed" HorizontalAlignment="Center" FontSize="11"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="Add Folder" Command="{Binding AddFolderCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Rescan" Command="{Binding RefreshLibraryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Padding="10,4" />
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Empty state: no scan folders configured yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoScanFolders, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No ROM folders configured yet" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <Button Content="Add Folder" Command="{Binding AddFolderCommand}" Padding="20,10" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Cover grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoScanFolders, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Status bar: scan/box-art progress -->
        <Grid Grid.Row="2" Margin="8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                <TextBlock Text="{Binding StatusMessage}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelScanCommand}" Padding="10,4" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
