<Window x:Class="Bridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Bridge.Converters"
        Title="Settings" Height="500" Width="700" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Emulators section -->
        <GroupBox Grid.Row="0" Header="Emulators">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding Platforms}"
                         SelectedItem="{Binding SelectedPlatform}"
                         DisplayMemberPath="PlatformName"
                         Margin="0,0,8,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Executable" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExecutableCommand}" Margin="6,0,0,0" Padding="8,4" />
                    </Grid>

                    <TextBlock Text="Argument Template" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                    <TextBlock Text="Must include {RomPath}. Example: &quot;{RomPath}&quot; -fullscreen"
                               Foreground="Gray" FontSize="11" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save Emulator Config" Command="{Binding SaveEmulatorProfileCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Auto-Install" Command="{Binding AutoInstallCommand}"
                                Visibility="{Binding SelectedPlatform.HasKnownInstallOption, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- SteamGridDB API key section -->
        <GroupBox Grid.Row="1" Header="SteamGridDB API Key" Margin="0,12,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Save Key" Command="{Binding SaveApiKeyCommand}" Margin="6,0,0,0" Padding="10,4" />
            </Grid>
        </GroupBox>

        <!-- TheGamesDB API key section (metadata-source decision, 2026-08-04) -->
        <GroupBox Grid.Row="2" Header="TheGamesDB API Key" Margin="0,12,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TheGamesDbApiKey, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Save Key" Command="{Binding SaveTheGamesDbApiKeyCommand}" Margin="6,0,0,0" Padding="10,4" />
            </Grid>
        </GroupBox>

        <!-- Cheats section -->
        <GroupBox Grid.Row="3" Header="Cheats" Margin="0,12,0,0">
            <CheckBox Margin="6" Content="Auto-apply cheats on launch"
                      IsChecked="{Binding AutoApplyCheatsOnLaunch}"
                      Command="{Binding SaveAutoApplyCheatsOnLaunchCommand}" />
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <!-- Busy: auto-install progress -->
            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelInstallCommand}" Padding="10,4" Margin="8,0,0,0" />
            </Grid>

            <!-- Not busy: plain status text (Saved., API key saved., etc.) -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green"
                       Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
