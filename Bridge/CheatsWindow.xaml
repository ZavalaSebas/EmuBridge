<Window x:Class="Bridge.CheatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bridge.ViewModels"
        Title="{Binding GameName}" Height="420" Width="480"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GameName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,2,0,12">
            <Run Text="Platform: " Foreground="Gray" />
            <Run Text="{Binding PlatformName, Mode=OneWay}" Foreground="Gray" />
        </TextBlock>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                <Condition Binding="{Binding HasCheats}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCheats, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Cheats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheatItem}">
                        <CheckBox Content="{Binding Description}" IsChecked="{Binding Enabled}"
                                  Command="{Binding DataContext.ToggleCheatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Margin="0,8,0,0"
                    Visibility="{Binding HasCheats, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Cheats sourced from the libretro-database project, licensed CC BY-SA 4.0."
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0">
                <Run Text="Source: " />
                <Run Text="{Binding SourceFileUrl, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" IsCancel="True" Padding="14,4" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
