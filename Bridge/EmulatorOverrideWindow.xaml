<Window x:Class="Bridge.EmulatorOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding GameName}" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GameName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,2,0,12">
            <Run Text="Platform: " Foreground="Gray" />
            <Run Text="{Binding PlatformName, Mode=OneWay}" Foreground="Gray" />
            <Run Text=" — " Foreground="Gray" />
            <Run Foreground="Gray">
                <Run.Style>
                    <Style TargetType="Run">
                        <Setter Property="Text" Value="using platform default (no override)" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverride}" Value="True">
                                <Setter Property="Text" Value="override active for this game" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Run.Style>
            </Run>
        </TextBlock>

        <TextBlock Grid.Row="2" Text="Executable" FontWeight="Bold" Margin="0,0,0,4" />
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExecutableCommand}" Margin="6,0,0,0" Padding="8,4" />
        </Grid>

        <TextBlock Grid.Row="4" Text="Argument Template" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Grid.Row="5" VerticalAlignment="Top">
            <TextBox Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
            <TextBlock Text="Must include {RomPath}. Example: &quot;{RomPath}&quot; -fullscreen --extra-flag"
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Saving here only affects this one game — the platform's own default (Settings) is never changed."
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Remove Override" Command="{Binding ClearOverrideCommand}"
                        IsEnabled="{Binding HasOverride}" Padding="10,4" Margin="0,0,8,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" Padding="14,4" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
